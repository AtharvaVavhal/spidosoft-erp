# Copy to .env.local to override. Never commit real secrets.

# Base path for API calls from the browser. In dev, Vite proxies it to VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=/api
# Dev-server proxy target for /api (Spring Boot backend).
VITE_API_PROXY_TARGET=http://localhost:8080
# Domain data (items, customers, suppliers) comes from in-memory mock adapters until the backend
# contracts are implemented (docs/10 §10). Only "true" is supported today.
VITE_USE_MOCKS=true
